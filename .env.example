# PrepAI environment template — copy to .env and fill in values.
# Never commit .env with real secrets.

# Required — Groq LLM (server-side only)
GROQ_API_KEY=gsk_your_key_here

# Required for Redis session memory (local / split compose)
REDIS_URL=redis://localhost:6379

# Optional — Whisper STT via Hugging Face Inference API
HUGGINGFACE_API_KEY=hf_your_key_here

# CORS allowed origin (production Space URL or local frontend)
FRONTEND_URL=http://localhost:7860

# Guest JWT signing secret (required in production — use a long random string)
PREPAI_JWT_SECRET=change_me_to_a_long_random_secret
PREPAI_TOKEN_TTL_SEC=3600

# Production hardening flags (set true on HF Spaces)
DISABLE_DOCS=true
TRUST_PROXY=true
ENVIRONMENT=production

# Frontend API base URL (build-time for Vite). Empty = same-origin (HF Spaces / unified Docker).
# Local Vite dev against split backend: http://localhost:8000
VITE_API_URL=

# Optional quiz via local Ollama instead of Groq
VITE_USE_OLLAMA=false
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2
